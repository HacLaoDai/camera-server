# Copy file này thành ".env" (cùng thư mục docker-compose.yml) rồi điền
# thông tin thật. KHÔNG commit file ".env" thật vào git.
#
# Vì mật khẩu Mongo cũ (baoan_dev / 5769boan20s12rui @ 103.159.51.61) đã bị
# dán vào một cuộc trò chuyện AI, hãy COI NHƯ ĐÃ LỘ và đổi mật khẩu đó trên
# MongoDB trước khi dùng URI mới ở đây.
MONGO_URI=mongodb://<user>:<pass>@<host>:<port>/<db_name>
