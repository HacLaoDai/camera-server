# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# insightface==0.7.3 build lỗi với Cython 3.x mặc định -> ghim cython<3,
# cài trước cùng numpy, rồi cài requirements với --no-build-isolation.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir "cython<3" numpy==1.26.4

COPY requirements-api.txt .
RUN pip install --no-cache-dir --no-build-isolation -r requirements-api.txt

# api_server.py chỉ cần database/ và detectors/detect_face.py (ArcFaceExtractor)
# - KHÔNG cần camera/, trackers/, recognition/, và KHÔNG cần file .pt của YOLO.
COPY database ./database
COPY detectors/detect_face.py ./detectors/detect_face.py
COPY api_server.py .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0) if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).status==200 else sys.exit(1)"

CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
