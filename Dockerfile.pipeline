# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Thư viện hệ thống cần cho opencv-headless / onnxruntime / faiss / font
# tiếng Việt (PIL vẽ text lên ảnh face_events, xem database/task_db.py) +
# build-essential/cmake/git để BUILD insightface (có extension C/Cython,
# không có sẵn wheel dựng sẵn cho mọi môi trường -> pip phải tự compile).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# QUAN TRỌNG: insightface==0.7.3 dùng cú pháp Cython CŨ, build LỖI với
# Cython 3.x (mặc định pip cài bản mới nhất nếu không ghim version). Phải
# cài sẵn cython<3 + numpy TRƯỚC, rồi cài insightface với
# --no-build-isolation để nó dùng đúng cython/numpy đã cài thay vì tự tải
# bản mới nhất vào môi trường build cô lập (build isolation).
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir "cython<3" numpy==1.26.4

# Cài torch bản CPU-ONLY từ index riêng của PyTorch TRƯỚC - nếu để pip tự
# cài torch qua PyPI mặc định lúc cài ultralytics, có thể kéo theo các gói
# nvidia-*.whl (CUDA runtime) nặng thêm hàng GB dù server không có GPU.
RUN pip install --no-cache-dir torch==2.3.1 --index-url https://download.pytorch.org/whl/cpu

COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir --no-build-isolation -r requirements-pipeline.txt

# Copy đúng cấu trúc package mà multi_main.py import (camera.*, database.*,
# detectors.*, trackers.*, recognition.*)
COPY camera ./camera
COPY database ./database
COPY detectors ./detectors
COPY trackers ./trackers
COPY recognition ./recognition
COPY multi_main.py .

# QUAN TRỌNG: detectors/yolov8n.pt PHẢI có mặt trong thư mục build context
# (copy từ project gốc) trước khi build - xem hướng dẫn build kèm theo.
RUN test -f detectors/yolov8n.pt || \
    (echo "LỖI: thiếu detectors/yolov8n.pt trong build context - xem README" && exit 1)

RUN mkdir -p logs saved_person pending_face_events

ENV LOG_DIR=/app/logs \
    PENDING_EVENTS_DIR=/app/pending_face_events \
    STREAM_HOST=0.0.0.0 \
    STREAM_PORT=8090 \
    STREAM_FPS=10

EXPOSE 8090

# healthcheck đơn giản qua chính HTTP server MJPEG (/health)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0) if urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=3).status==200 else sys.exit(1)"

CMD ["python", "multi_main.py"]
